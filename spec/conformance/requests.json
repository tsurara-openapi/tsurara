          }
        }
      },
      "responses": {
        "204": {
          "parseAs": "none"
        }
      }
    },
    "input": {
      "body": {
        "file": {
          "$file": {
            "name": "a.txt",
            "type": "text/plain",
            "text": "hello"
          }
        },
        "tags": ["x", "y"],
        "meta": {
          "a": 1
        },
        "n": 3
      }
    },
    "expect": {
      "method": "POST",
      "url": "https://api.test/x",
      "body": {
        "form": [
          [
            "file",
            {
              "$file": {
                "name": "a.txt",
                "type": "text/plain",
                "text": "hello"
              }
            }
          ],
          ["tags", "x"],
          ["tags", "y"],
          [
            "meta",
            {
              "$blob": {
                "type": "application/json",
                "text": "{\"a\":1}"
              }
            }
          ],
          ["n", "3"]
        ]
      }
    }
  },
