{
  "name": "@tsurara/client",
  "version": "0.1.1",
  "description": "Runtime library for code generated by tsurara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsurara-openapi/tsurara.git",
    "directory": "runtimes/typescript"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@tanstack/query-core": "5.107.1",
    "@types/node": "^22.19.0",
    "typescript": "7.0.2",
    "valibot": "1.5.0"
  }
}
