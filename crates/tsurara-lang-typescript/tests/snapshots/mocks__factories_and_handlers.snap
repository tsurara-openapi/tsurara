import type { Pet } from '../../schemas/Pet.js';
import { mockOwner } from './Owner.js';

/** A `Pet` with the sample values of the definition; `overrides` replace properties. */
export function mockPet(overrides?: Partial<Pet>): Pet {
  return {
    id: 1,
    name: 'Pochi',
    owner: mockOwner(),
    parent: {
      id: 1,
      name: 'Pochi',
      owner: mockOwner(),
    },
    ...overrides,
  };
}

// Generated by tsurara. Do not edit.

import { type HttpHandler, http } from 'msw';
import type { Pet } from '../../schemas/Pet.js';
import type { Problem } from '../../schemas/Problem.js';
import { mockPet } from '../schemas/Pet.js';
import { respond } from '../support.js';
import type { MockInfo, MockOptions } from '../support.js';

/** A response of `getPet` that the definition documents. */
export type GetPetMockResponse =
  | { status: 200; body: Pet }
  | { status: 404; body: Problem };

/**
 * Answers `GET /pets/{petId}` with `response` (by default its first documented success with the sample
 * values).
 */
export function getPetHandler(
  response: GetPetMockResponse | ((info: MockInfo) => GetPetMockResponse | Promise<GetPetMockResponse>) = { status: 200, body: mockPet() },
  options: MockOptions = {},
): HttpHandler {
  return http.get(
    `${options.baseUrl ?? '*'}/pets/:petId`,
    async (info) => {
      const r = typeof response === 'function' ? await response(info) : response;
      return respond(r, { 200: ['json', 'application/json'], 404: ['json', 'application/json'] });
    },
    { once: options.once ?? false },
  );
}

