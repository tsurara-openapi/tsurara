import type { Client, RequestOptions, TransportFailure } from '@tsurara/client';
import type { Item } from '../schemas/Item.js';
import type { Problem } from '../schemas/Problem.js';

export type GetItemData = {
  path: { itemId: number };
  query?: {
    fields?: string[];
    filter?: { min?: number };
    meta?: { a?: string };
  };
  headers?: { 'X-Trace'?: string };
  cookies?: { session?: string };
};

export type GetItemResponses = {
  200: Item | string;
  304: undefined;
};

export type GetItemErrors = {
  404: Problem;
  '5XX': string;
  default: Problem;
};

export type GetItemResponseHeaders = {
  200: {
    /** Requests left */
    'x-rate-limit': number;
  };
};

export type GetItemResult =
  | { ok: true; kind: 'success'; status: 200; data: Item | string; response: Response }
  | { ok: true; kind: 'success'; status: 304; data: undefined; response: Response }
  | { ok: false; kind: 'http'; documented: true; status: 404; error: Problem; response: Response }
  | { ok: false; kind: 'http'; documented: true; status: number; error: string; response: Response }
  | { ok: false; kind: 'http'; documented: true; status: number; error: Problem; response: Response }
  | { ok: false; kind: 'http'; documented: false; status: number; error: unknown; response: Response }
  | TransportFailure;

export const getItemDef = {
  v: 1,
  id: 'getItem',
  method: 'GET',
  path: '/items/{itemId}',
  tags: ['items'],
  params: {
    path: { itemId: {} },
    query: { fields: { style: 'form', explode: false }, filter: { style: 'deepObject', explode: true }, meta: { contentType: 'application/json' } },
    headers: { 'X-Trace': {} },
    cookies: { session: {} },
  },
  responses: {
    200: { parseAs: 'json', contentTypes: { 'application/json': 'json', 'text/csv': 'text' } },
    304: { parseAs: 'none' },
    404: { parseAs: 'json' },
    '5XX': { parseAs: 'text' },
    default: { parseAs: 'json' },
  },
} as const;

/**
 * Get an item
 *
 * Returns one item.
 */
export function getItem<Ctx>(
  client: Client<Ctx>,
  options: GetItemData & RequestOptions<Ctx>,
): Promise<GetItemResult> {
  return client.request<GetItemResult>(getItemDef, options);
}

