/** The base URL of the API. The servers in the definition are suggested, and any URL is accepted. */
export type BaseUrl =
  | `https://${'api' | 'staging'}.example.com/v1`
  | '/relative'
  | (string & {});

export const servers = [
  { url: 'https://{env}.example.com/v1', description: 'Main', variables: { env: { default: 'api', enum: ['api', 'staging'] } } },
  { url: '/relative' },
] as const;

