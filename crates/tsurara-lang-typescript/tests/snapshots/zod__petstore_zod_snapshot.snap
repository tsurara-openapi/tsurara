export const PetSchema: z.ZodType = z.object({ id: z.number().int().optional(), name: z.string(), category: z.lazy(() => CategorySchema).optional(), photoUrls: z.array(z.string()), tags: z.array(z.lazy(() => TagSchema)).optional(), status: z.enum(['available', 'pending', 'sold']).optional() });

