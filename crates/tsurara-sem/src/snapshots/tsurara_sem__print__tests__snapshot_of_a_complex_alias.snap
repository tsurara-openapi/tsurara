/**
 * A pet in the store.
 * @see https://example.com
 */
export type Pet = Base & {
  /**
   * Unique id
   * @format int64
   */
  id: number;
  status?: 'available' | 'sold' | null;
  position: [number, number];
  extra: { 'x-y': string; [key: string]: string | number };
};
