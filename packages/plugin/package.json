{
  "name": "@tsurara/plugin",
  "version": "0.1.0",
  "description": "Write tsurara plugins in TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsurara-openapi/tsurara.git",
    "directory": "packages/plugin"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "7.0.2"
  }
}
